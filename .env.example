# Get your API key at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_api_key_here

# SteamID64 of your main account (optional, but recommended)
MY_STEAM_ID=your_steamid64

# Additional SteamID64 values, separated by commas (optional)
STEAM_FAMILY_MEMBER_IDS=

# In-memory cache and request pacing (optional)
STEAM_CACHE_TTL_MS=30000
STEAM_MIN_REQUEST_INTERVAL_MS=100
